OPENAI_API_KEY="RELLENAR"
TREND_API_KEY="RELLENAR"
FILE_SECURITY_API_KEY="RELLENAR"
FILE_SECURITY_REGISTRATION_TOKEN="RELLENAR"
TREND_AI_URL="https://api.eu.xdr.trendmicro.com/v3.0/aiSecurity/applyGuardrails"
TREND_AI_APP_NAME="ai-untamiento-trendo"
FILE_SECURITY_HOST="my-release-visionone-filesecurity-scanner.visionone-filesecurity.svc.cluster.local:50051"
BACKEND_LOCAL_PORT="9000"
FRONTEND_LOCAL_PORT="8081"

# -------------------------------------------------------------------
# TMAS AI Scanner (escaneo de vulnerabilidades del modelo LLM)
# Requerido para: ./scripts/run_ai_scanner.sh
#
# TMAS_API_KEY : Vision One API key (la misma que se usa en CI/CD)
#                Requiere un rol con permisos de AI Scanner.
#                Ver: Vision One > Administration > API Keys
#
# OPENAI_API_KEY ya está definida arriba y se reutiliza como
# TARGET_API_KEY para apuntar al modelo objetivo del escaneo.
# -------------------------------------------------------------------
TMAS_API_KEY="RELLENAR"

# Política y modelo del backend desplegado: k8s/config.yaml.
# Subidas limitadas a 20 MiB (backend y Nginx); eventos retenidos 7 días.
